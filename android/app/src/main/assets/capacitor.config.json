{
	"appId": "com.aetherx.wallpapers",
	"appName": "AetherX",
	"webDir": "public/dist",
	"backgroundColor": "#02040a",
	"android": {
		"backgroundColor": "#02040a",
		"allowMixedContent": false,
		"webContentsDebuggingEnabled": true,
		"captureInput": true
	},
	"ios": {
		"backgroundColor": "#02040a",
		"contentInset": "always"
	},
	"plugins": {
		"SplashScreen": {
			"backgroundColor": "#02040a",
			"showSpinner": false,
			"launchAutoHide": true,
			"launchShowDuration": 1500
		}
	}
}
